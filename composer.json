{
    "name": "informaticadoslago/generador-plantillas",
    "description": "Editor visual de plantillas de informes (XML) para Laravel: tabla de plantillas polimórfica, API para el editor y, más adelante, generación de PDF.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "plantillas", "informes", "pdf", "editor", "facturas"],
    "authors": [
        {
            "name": "Alberto Lago Rodríguez",
            "homepage": "https://github.com/informaticadoslago"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "InformaticadosLago\\GeneradorPlantillas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InformaticadosLago\\GeneradorPlantillas\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InformaticadosLago\\GeneradorPlantillas\\GeneradorPlantillasServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
